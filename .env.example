# Copy to .env.local (git-ignored) and adjust for your machine.
# EXPO_PUBLIC_* values are bundled into the app and readable by anyone: never put secrets here.

# Laravel API base URL including the /api prefix. Required for production (must be HTTPS).
# Examples:
#   Laragon / artisan serve reached from a phone on the same Wi-Fi: http://192.168.1.20:8000/api
#   Android emulator:                                              http://10.0.2.2:8000/api
#   iOS simulator:                                                 http://localhost:8000/api
#   Production:                                                    https://api.example.com/api
# Leave empty in development to auto-detect the machine running Metro (see src/constants/api.ts).
EXPO_PUBLIC_API_BASE_URL=

# Port used for auto-detection when EXPO_PUBLIC_API_BASE_URL is empty.
EXPO_PUBLIC_API_PORT=8000

# TEMPORARY: use in-memory mock services until the Laravel API exists. Ignored in release builds.
# Demo login in mock mode: juan@example.com / password123
EXPO_PUBLIC_USE_MOCK_API=true
